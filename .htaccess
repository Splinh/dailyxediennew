RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteBase /

# =========================================================
# CRITICAL SECURITY GUARDS & ANTI-MALWARE
# =========================================================

# 1. Chặn tuyệt đối truy cập file nhạy cảm (.env, .git, .ini, lock files, configs)
<FilesMatch "^(\.env|\.git|\.user\.ini|composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|web\.config|\.phpcs-cache|\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Fallback Rewrite chặn truy cập các file ẩn bắt đầu bằng dấu chấm và config
RewriteRule ^\.(.*)$ - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^wp-config\.php$ - [F,L]
RewriteRule ^wp/wp-config\.php$ - [F,L]
# 2b. Chặn thư mục/file ẩn ở MỌI cấp (shell từng nằm trong */.well-known/.90d148...system/)
#     Chỉ chừa /.well-known/acme-challenge/ ở gốc cho SSL Let's Encrypt.
RewriteRule (^|/)\.(?!well-known/acme-challenge/) - [F,L]

# 2c. OpenLiteSpeed bỏ qua <FilesMatch>/<Files> nên phải chặn bằng RewriteRule.
#     File dev/backup nằm ở web root: md, xlsx, csv, sql, rdb, bat, yaml, lock, zip...
RewriteRule ^[^/]+\.(md|xlsx?|csv|sql|rdb|bat|ya?ml|lock|log|sh|zip|tar|gz|bak|dist)$ - [F,NC,L]
RewriteRule ^(composer|package|lh_report|lh_verify)\.json$ - [F,NC,L]
RewriteRule ^(phpunit|phpcs)\.xml$ - [F,NC,L]
RewriteRule ^(config|vendor|scripts|docs|wpfm-private-backups)(/|$) - [F,NC,L]

# 3. Chặn XML-RPC (nguồn tấn công brute-force & DDoS của botnet)
<Files xmlrpc.php>
    Order allow,deny
    Deny from all
</Files>
RewriteRule (^|/)xmlrpc\.php$ - [F,NC,L]

# 4. Chặn đứng thực thi file PHP trong thư mục uploads và cache
RewriteRule ^wp/wp-content/uploads/.*\.php$ - [F,L]
RewriteRule ^wp-content/uploads/.*\.php$ - [F,L]
RewriteRule ^wp/wp-content/cache/.*\.php$ - [F,L]
# 4b. Không file PHP nào trong các thư mục này cần truy cập trực tiếp qua URL
RewriteRule ^(wp/)?wp-content/(uploads|cache|languages|upgrade|mu-plugins|litespeed)/.*\.(php\d?|phtml|phar)$ - [F,NC,L]
RewriteRule ^(wp/)?wp-content/themes/.*\.(php\d?|phtml|phar)$ - [F,NC,L]
# PHP nằm thẳng trong wp-content/ hoặc plugins/ (vd: plugins/7j958gt0oflifFM.php)
RewriteRule ^(wp/)?wp-content/(plugins/)?[^/]+\.(php\d?|phtml|phar)$ - [F,NC,L]
# 4c. Ở wp/ gốc chỉ cho phép entry point của WordPress core (chặn wp/177.php, wp/wp-links-opmI.php...)
RewriteRule ^wp/(?!(index|wp-login|wp-cron|wp-comments-post|wp-signup|wp-activate|wp-trackback|wp-mail)\.php$)[^/]+\.(php\d?|phtml|phar)$ - [F,NC,L]
# 4d. Ở web root chỉ cho phép index.php (chỉ áp dụng với file thật, không ảnh hưởng rewrite /wp-login.php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?!index\.php$)[^/]+\.(php\d?|phtml|phar)$ - [F,NC,L]

# 5. Chặn truy cập trực tiếp thư mục scripts/ từ bên ngoài
RewriteRule ^scripts/.*\.php$ - [F,L]

# 6. Chặn dò quét username tác giả (Author enumeration)
RewriteCond %{QUERY_STRING} ^author=([0-9]+) [NC]
RewriteRule ^ - [F,L]

# 7. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteRule ^index\.php$ - [L]

# Auto-add slash for wp-admin
RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ $1wp-admin/ [R=301,L]

# Normal files -> allow
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map WordPress core paths to /wp
RewriteRule ^([_0-9a-zA-Z-]+/)?(wp-(content|admin|includes).*) wp/$2 [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(.*\.php)$ wp/$2 [L]

# Fallback
RewriteRule . index.php [L]

# BEGIN WordPress
# Các nội dung nằm giữa "BEGIN WordPress" và "END WordPress" được tạo ra tự động, và chỉ nên được thay đổi thông qua các filter của WordPress. Mọi thay đổi tới thành phần này có thể sẽ bị mất và ghi đè.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# BEGIN LiteSpeed Cache
<IfModule LiteSpeed>
SettingEngine on
CacheLookup on
</IfModule>
# END LiteSpeed Cache
